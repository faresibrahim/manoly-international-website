@model ManolyWarehouse.Application.ViewModels.ProductDeletionImpact
@{ 
    ViewData["Title"] = "حذف المنتج";
    var productId = ViewBag.ProductId as int? ?? 0;
    var productName = ViewBag.ProductName as string ?? "";
}

<div class="px-4 pt-5 pb-3">
    <a href="/products/@productId" class="eyebrow text-bark-l hover:text-bark mb-2 inline-flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        @productName
    </a>
    <p class="eyebrow mb-1">DELETE · حذف</p>
    <h1 class="font-display text-2xl text-rust">حذف المنتج</h1>
</div>

<div class="px-4 mb-6">

    @if (Model.HasImpact)
    {
        <div class="alert-warning mb-4">
            <strong>تحذير:</strong> هذا المنتج مرتبط ببيانات موجودة — سيتم حذفها أيضًا.
        </div>

        <div class="card mb-4">
            @if (Model.ShelfInventoryCount > 0)
            {
                <div class="list-item justify-between">
                    <span class="text-sm text-bark-d">مواضع الرف</span>
                    <span class="font-display text-base text-rust">@Model.ShelfInventoryCount</span>
                </div>
            }
            @if (Model.AreaZCount > 0)
            {
                <div class="list-item justify-between">
                    <span class="text-sm text-bark-d">سجلات منطقة Z</span>
                    <span class="font-display text-base text-rust">@Model.AreaZCount</span>
                </div>
            }
            @if (Model.OrderItemsCount > 0)
            {
                <div class="list-item justify-between">
                    <span class="text-sm text-bark-d">أصناف في الطلبيات</span>
                    <span class="font-display text-base text-rust">@Model.OrderItemsCount</span>
                </div>
            }
        </div>
    }

    <div class="card p-4 mb-4">
        <p class="text-sm text-bark-d">هل أنت متأكد من حذف <strong class="font-display text-base text-ink">@productName</strong>؟ لا يمكن التراجع عن هذا الإجراء.</p>
    </div>

    <form asp-action="Delete" asp-route-id="@productId" method="post" class="flex flex-col gap-3">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-danger w-full">نعم، احذف المنتج</button>
        <a href="/products/@productId" class="btn-secondary w-full text-center">إلغاء</a>
    </form>
</div>
