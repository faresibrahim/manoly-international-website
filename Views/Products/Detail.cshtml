@model ManolyWarehouse.Application.ViewModels.ProductDetailViewModel
@{ ViewData["Title"] = Model.Name; }

<div class="px-4 pt-5 pb-3">
    <a href="/products" class="eyebrow text-bark-l hover:text-bark mb-2 inline-flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        PRODUCTS · المنتجات
    </a>
    <div class="flex items-start justify-between gap-3">
        <h1 class="font-display text-2xl text-ink leading-tight">@Model.Name</h1>
        @if (User.IsInRole("Admin"))
        {
            <a href="/products/@Model.Id/edit" class="btn-secondary btn-sm shrink-0">تعديل</a>
        }
    </div>
    <p class="text-sm text-bark-l mt-1 font-ui">@Model.CategoryName</p>
</div>

<div class="px-4 space-y-4 mb-6">

    @* Shelf locations *@
    @if (Model.ShelfLocations.Any())
    {
        <div>
            <p class="eyebrow mb-2">SHELF LOCATIONS · مواضع الرف (@Model.ShelfLocations.Count)</p>
            <div class="card">
                @foreach (var loc in Model.ShelfLocations)
                {
                    <a href="/shelves/@loc.ShelfCode" class="list-item justify-between">
                        <div>
                            <span class="font-display text-base text-ink">رف @loc.ShelfCode</span>
                            <span class="text-xs text-bark-l mr-1">موضع @loc.Position</span>
                        </div>
                        <div class="text-left">
                            <span class="font-display text-base text-ink">@loc.BundleCount</span>
                            <span class="text-xs text-bark-l"> ربطة</span>
                            <div class="text-xs text-bark-l">@loc.TotalQuantity وحدة</div>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="empty-state py-8">
                <p class="empty-state-title text-base">لا يوجد في الأرفف</p>
            </div>
        </div>
    }

    @* Area Z *@
    @if (Model.AreaZ != null)
    {
        <div>
            <p class="eyebrow mb-2">AREA Z · منطقة Z</p>
            <div class="card">
                <a href="/area-z/@Model.AreaZ.Id" class="list-item justify-between">
                    <span class="text-sm text-ink">منطقة Z</span>
                    <div class="text-left">
                        <span class="font-display text-base text-ink">@Model.AreaZ.BundleCount</span>
                        <span class="text-xs text-bark-l"> ربطة</span>
                        <div class="text-xs text-bark-l">@Model.AreaZ.TotalQuantity وحدة</div>
                    </div>
                </a>
            </div>
        </div>
    }

    @* Admin actions *@
    @if (User.IsInRole("Admin"))
    {
        <div class="flex flex-col gap-2">
            <a href="/products/@Model.Id/edit" class="btn-secondary w-full text-center">تعديل المنتج</a>
            <a href="/products/@Model.Id/delete" class="btn-danger w-full text-center">حذف المنتج</a>
        </div>
    }
</div>
