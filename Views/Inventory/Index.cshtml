@model ManolyWarehouse.Application.ViewModels.InventorySummaryViewModel
@{ ViewData["Title"] = "المخزون"; }

@* ── Page header ──────────────────────────────────────────────────────────── *@
<div class="px-4 pt-5 pb-3">
    <p class="eyebrow mb-1">INVENTORY · المخزون</p>
    <h1 class="font-display text-3xl text-ink">المخزون</h1>
</div>

@* ── Summary stat bar ─────────────────────────────────────────────────────── *@
<div class="flex mx-4 mb-5 card">
    <div class="stat-block">
        <span class="stat-num">@Model.TotalProducts</span>
        <span class="stat-label">منتج · PRODUCTS</span>
    </div>
    <div class="stat-block">
        <span class="stat-num text-ember">@Model.TotalBundles</span>
        <span class="stat-label">ربطة · BUNDLES</span>
    </div>
    <div class="stat-block">
        <span class="stat-num text-moss">@Model.TotalUnits</span>
        <span class="stat-label">وحدة · UNITS</span>
    </div>
</div>

@* ── Category filter pills ────────────────────────────────────────────────── *@
@if (Model.Categories.Any())
{
    <div class="overflow-x-auto px-4 mb-5" style="scrollbar-width:none;">
        <div class="flex gap-2 min-w-max pb-1">
            @{
                var allActive = string.IsNullOrEmpty(Model.ActiveCategory);
            }
            <a href="/inventory"
               class="shrink-0 px-3 py-1.5 text-xs font-ui font-semibold rounded-full transition-colors"
               style="@(allActive ? "background:#1F1B17;color:#FAF8F4;" : "background:#F1ECE3;color:#847569;")">
                الكل
            </a>
            @foreach (var cat in Model.Categories.OrderBy(c => c.CategoryName))
            {
                var isActive = Model.ActiveCategory == cat.CategoryName;
                <a href="/inventory?category=@Uri.EscapeDataString(cat.CategoryName)"
                   class="shrink-0 px-3 py-1.5 text-xs font-ui font-semibold rounded-full transition-colors"
                   style="@(isActive ? "background:#1F1B17;color:#FAF8F4;" : "background:#F1ECE3;color:#847569;")">
                    @cat.CategoryName
                    <span class="opacity-60 ms-1">@cat.ProductCount</span>
                </a>
            }
        </div>
    </div>
}

@* ── Empty state ──────────────────────────────────────────────────────────── *@
@if (!Model.Categories.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">📦</div>
        <h2 class="empty-state-title">المستودع فارغ</h2>
        <p class="empty-state-desc">لا توجد منتجات في الأرفف أو منطقة Z</p>
    </div>
}
else
{
    @* ── Category groups ──────────────────────────────────────────────────── *@
    foreach (var cat in Model.Categories)
    {
        <div class="mb-6">
            @* Category header *@
            <div class="flex items-center justify-between px-4 mb-2">
                <p class="eyebrow">@cat.CategoryName</p>
                <div class="flex items-center gap-2">
                    <span class="text-xs text-bark-l font-ui">@cat.TotalBundles ربطة</span>
                    <span class="text-xs text-bark-l">·</span>
                    <span class="text-xs text-bark-l font-ui">@cat.ProductCount منتج</span>
                </div>
            </div>

            <div class="mx-4 card">
                @foreach (var product in cat.Products)
                {
                    @* ── Product row ───────────────────────────────────────── *@
                    <div class="border-b last:border-b-0"
                         style="border-color: #E4DCCC; border-width: 0.5px;">

                        @* Main product row — tappable to expand *@
                        <button onclick="toggleProduct(@product.ProductId)"
                                class="w-full px-4 py-3 flex items-center gap-3 text-right hover:bg-linen transition-colors"
                                aria-expanded="false"
                                id="btn-@product.ProductId">

                            @* Product name + totals *@
                            <div class="flex-1 min-w-0">
                                <div class="font-display text-base text-ink truncate">@product.ProductName</div>
                                <div class="flex items-center gap-2 mt-0.5 flex-wrap">
                                    @if (product.ShelfLocationCount > 0)
                                    {
                                        <span class="text-xs text-bark-l font-ui">
                                            @product.ShelfLocationCount
                                            @(product.ShelfLocationCount == 1 ? "رف" : "أرفف")
                                        </span>
                                    }
                                    @if (product.AreaZBundles > 0)
                                    {
                                        <span class="text-xs text-amber font-ui font-semibold">منطقة Z</span>
                                    }
                                </div>
                            </div>

                            @* Bundle + unit totals *@
                            <div class="text-left shrink-0">
                                <div class="flex items-baseline gap-1 justify-end">
                                    <span class="font-display text-xl text-ink">@product.TotalBundles</span>
                                    <span class="text-xs text-bark-l">ربطة</span>
                                </div>
                                <div class="text-xs text-bark-l text-left">@product.TotalUnits وحدة</div>
                            </div>

                            @* Chevron *@
                            <svg id="chevron-@product.ProductId"
                                 class="w-4 h-4 text-bark-l shrink-0 transition-transform duration-200"
                                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>

                        @* ── Expandable location rows ───────────────────── *@
                        <div id="product-@product.ProductId"
                             class="hidden"
                             style="background:#F1ECE3; border-top: 0.5px solid #E4DCCC;">

                            @* Shelf locations *@
                            @foreach (var loc in product.Locations)
                            {
                                <a href="/shelves/@loc.ShelfCode"
                                   class="flex items-center gap-3 px-5 py-2.5 hover:bg-sand transition-colors"
                                   style="border-bottom: 0.5px solid #E4DCCC;">

                                    @* Shelf code badge *@
                                    <div class="shrink-0 w-12 h-8 rounded flex items-center justify-center"
                                         style="background:#E4DCCC;">
                                        <span class="font-display text-sm text-ink">@loc.ShelfCode</span>
                                    </div>

                                    @* Position + detail *@
                                    <div class="flex-1 min-w-0">
                                        <span class="text-xs text-bark-l font-ui">موضع @loc.Position</span>
                                    </div>

                                    @* Qty *@
                                    <div class="text-left shrink-0">
                                        <span class="font-display text-base text-ink">@loc.BundleCount</span>
                                        <span class="text-xs text-bark-l"> ربطة</span>
                                        <div class="text-xs text-bark-l">× @loc.UnitsPerBundle = @loc.TotalQuantity</div>
                                    </div>

                                    @* Arrow → shelf *@
                                    <svg class="w-3.5 h-3.5 text-ember shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                                    </svg>
                                </a>
                            }

                            @* Area Z row *@
                            @if (product.AreaZBundles > 0)
                            {
                                <a href="/area-z"
                                   class="flex items-center gap-3 px-5 py-2.5 hover:bg-sand transition-colors">

                                    <div class="shrink-0 w-12 h-8 rounded flex items-center justify-center"
                                         style="background:#C8893B22;">
                                        <span class="font-display text-sm text-amber">Z</span>
                                    </div>

                                    <div class="flex-1 min-w-0">
                                        <span class="text-xs text-amber font-ui font-semibold">منطقة الانتظار</span>
                                    </div>

                                    <div class="text-left shrink-0">
                                        <span class="font-display text-base text-ink">@product.AreaZBundles</span>
                                        <span class="text-xs text-bark-l"> ربطة</span>
                                        <div class="text-xs text-bark-l">@product.AreaZUnits وحدة</div>
                                    </div>

                                    <svg class="w-3.5 h-3.5 text-ember shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                                    </svg>
                                </a>
                            }

                            @* No locations fallback *@
                            @if (!product.Locations.Any() && product.AreaZBundles == 0)
                            {
                                <div class="px-5 py-3">
                                    <span class="text-xs text-bark-l italic">لا توجد مواضع محددة</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

@section Scripts {
<script>
function toggleProduct(id) {
    const panel   = document.getElementById('product-' + id);
    const chevron = document.getElementById('chevron-' + id);
    const btn     = document.getElementById('btn-' + id);
    const isOpen  = !panel.classList.contains('hidden');

    panel.classList.toggle('hidden', isOpen);
    chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
    btn.setAttribute('aria-expanded', String(!isOpen));
}
</script>
}
