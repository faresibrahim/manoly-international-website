@{
    ViewData["Title"] = "تعديل الكمية";
    var code        = ViewBag.ShelfCode      as string ?? "";
    var inventoryId = ViewBag.InventoryId    as int?   ?? 0;
    var bundleCount = ViewBag.BundleCount    as int?   ?? 1;
    var unitsPer    = ViewBag.UnitsPerBundle as int?   ?? 1;
}

<div class="px-4 pt-5 pb-3">
    <a href="/shelves/@code" class="eyebrow text-bark-l hover:text-bark mb-2 inline-flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
        رف @code
    </a>
    <p class="eyebrow mb-1">EDIT · تعديل</p>
    <h1 class="font-display text-2xl text-ink">تعديل الكمية</h1>
</div>

<div class="mx-4 card p-5 mb-6">
    <form action="/shelves/@code/inventory/@inventoryId/adjust" method="post" class="flex flex-col gap-5">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-2 gap-3">
            <div class="form-group">
                <label class="form-label">عدد الربطات</label>
                <input type="number" name="bundleCount" min="1" value="@bundleCount" class="form-input" required />
            </div>
            <div class="form-group">
                <label class="form-label">وحدات / ربطة</label>
                <input type="number" name="unitsPerBundle" min="1" value="@unitsPer" class="form-input" required />
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">ملاحظات (اختيارية)</label>
            <input type="text" name="notes" class="form-input" placeholder="سبب التعديل..." />
        </div>

        <button type="submit" class="btn-primary w-full">حفظ التعديلات</button>
        <a href="/shelves/@code" class="btn-secondary w-full text-center">إلغاء</a>
    </form>
</div>
