@model ManolyWarehouse.Application.ViewModels.LoginViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
    <meta name="theme-color" content="#FAF8F4"/>
    <title>تسجيل الدخول — مخزن منولي</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-linen min-h-screen flex flex-col items-center justify-center px-5">

    <div class="w-full max-w-sm animate-fade-in">

        @* Brand mark *@
        <div class="text-center mb-10">
            <img src="~/images/logo.jpg" alt="Manoly International"
                 style="height:140px; width:auto; max-width:280px; mix-blend-mode:multiply; object-fit:contain; margin:0 auto 12px;" />
            <h1 class="font-display text-2xl text-ink">مخزن منولي</h1>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-error mb-5 animate-fade-in" role="alert">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <div class="card p-6">
            <form asp-action="Login" method="post" class="flex flex-col gap-5">
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden"/>

                <div class="form-group">
                    <label asp-for="UserName" class="form-label">اسم المستخدم</label>
                    <input asp-for="UserName"
                           class="form-input"
                           autocomplete="username"
                           autocapitalize="none"
                           autocorrect="off"
                           spellcheck="false"
                           placeholder="أدخل اسم المستخدم"/>
                    <span asp-validation-for="UserName" class="form-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">كلمة المرور</label>
                    <div class="relative">
                        <input asp-for="Password"
                               type="password"
                               id="password-input"
                               class="form-input ps-12"
                               autocomplete="current-password"
                               placeholder="أدخل كلمة المرور"/>
                        <button type="button"
                                onclick="togglePassword()"
                                class="absolute top-1/2 -translate-y-1/2 end-3 text-bark-l hover:text-bark p-1"
                                aria-label="إظهار/إخفاء كلمة المرور">
                            <svg id="eye-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="form-error"></span>
                </div>

                <button type="submit" class="btn-primary w-full mt-1">
                    تسجيل الدخول
                </button>
            </form>
        </div>

    </div>

    <script>
        function togglePassword() {
            const input = document.getElementById('password-input');
            input.type = input.type === 'password' ? 'text' : 'password';
        }
    </script>
</body>
</html>
