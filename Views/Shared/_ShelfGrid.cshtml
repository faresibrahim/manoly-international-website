@model IReadOnlyList<ManolyWarehouse.Application.ViewModels.ShelfGridCell>
@{
    var columns = Model
        .GroupBy(c => c.Number)
        .OrderBy(g => g.Key)
        .ToList();
    int colCount = columns.Count; // 69
}

<div class="shelf-grid-wrapper" style="--cols: @colCount;">
    <div class="shelf-grid-inner">
        @foreach (var col in columns)
        {
            var slots = col.OrderBy(c => c.Label).ToList();
            <div class="shelf-grid-col">
                @foreach (var cell in slots)
                {
                    @{
                        string cellClass = cell.IsEmpty ? "grid-cell-empty"
                            : cell.IsFull ? "grid-cell-full"
                            : cell.OccupiedSlots switch {
                                1 => "grid-cell-partial-1",
                                2 => "grid-cell-partial-2",
                                3 => "grid-cell-partial-3",
                                4 => "grid-cell-partial-4",
                                _ => "grid-cell-partial-5",
                            };
                    }
                    <a href="/shelves/@cell.Code"
                       class="shelf-grid-cell @cellClass"
                       title="@cell.Code — @cell.OccupiedSlots/6"
                       aria-label="رف @cell.Code — @cell.OccupiedSlots من 6 مشغول">
                    </a>
                }
            </div>
        }
    </div>
</div>

<style>
.shelf-grid-wrapper {
    width: 100%;
    padding: 0 8px;
    box-sizing: border-box;
}

.shelf-grid-inner {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 1px;
    width: 100%;
}

@media (min-width: 480px) {
    .shelf-grid-wrapper { padding: 0 16px; }
    .shelf-grid-inner   { gap: 2px; }
}

.shelf-grid-col {
    display: flex;
    flex-direction: column;
    gap: 1px;
}

@media (min-width: 480px) {
    .shelf-grid-col { gap: 2px; }
}

.shelf-grid-cell {
    display: block;
    aspect-ratio: 1 / 1;
    width: 100%;
    border-radius: 1px;
    cursor: pointer;
    transition: opacity 100ms;
    min-width: 0;
}

@media (min-width: 480px) {
    .shelf-grid-cell { border-radius: 2px; }
}

@media (hover: hover) {
    .shelf-grid-cell:hover {
        transform: scale(1.4);
        z-index: 1;
        position: relative;
    }
}
</style>