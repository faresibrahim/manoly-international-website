@model ManolyWarehouse.Application.ViewModels.PagedResult<ManolyWarehouse.Application.ViewModels.OrderListItemViewModel>
@using ManolyWarehouse.Domain.Entities
@{
    ViewData["Title"] = "الطلبيات";
    var current = Context.Request.Query["status"].ToString();
    var baseUrl = string.IsNullOrEmpty(current) ? "/orders" : $"/orders?status={current}";
    var pager = ManolyWarehouse.Application.ViewModels.PaginationViewModel.From(Model, baseUrl);
}

<div class="px-4 pt-5 pb-3 flex items-end justify-between">
    <div>
        <p class="eyebrow mb-1">ORDERS · الطلبيات</p>
        <h1 class="font-display text-3xl text-ink">الطلبيات</h1>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a href="/orders/create" class="btn-primary btn-sm">+ جديدة</a>
    }
</div>

@* Status filter tabs *@
<div class="flex gap-2 px-4 mb-5 overflow-x-auto" style="scrollbar-width:none;">
    @{
        var statuses = new[] {
            ("", "الكل"),
            ("Ordered", "مطلوب"),
            ("Shipped", "مشحون"),
            ("ArrivingSoon", "وصول قريب"),
            ("Received", "مستلم"),
            ("Cancelled", "ملغي")
        };
    }
    @foreach (var (val, label) in statuses)
    {
        var isActive = current == val;
        <a href="/orders@(string.IsNullOrEmpty(val) ? "" : "?status=" + val)"
           class="shrink-0 px-3 py-1.5 text-xs font-ui font-semibold rounded-full transition-colors"
           style="@(isActive ? "background:#1F1B17; color:#FAF8F4;" : "background:#F1ECE3; color:#847569;")">
            @label
        </a>
    }
</div>

@if (!Model.Items.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">📋</div>
        <h2 class="empty-state-title">لا توجد طلبيات</h2>
        <p class="empty-state-desc">لم يتم إنشاء أي طلبيات حتى الآن</p>
    </div>
}
else
{
    <div class="mx-4 card mb-4">
        @foreach (var o in Model.Items)
        {
            var badgeClass = o.Status switch {
                OrderStatus.Ordered     => "badge-ordered",
                OrderStatus.Shipped     => "badge-shipped",
                OrderStatus.ArrivingSoon=> "badge-arriving",
                OrderStatus.Received    => "badge-received",
                OrderStatus.Cancelled   => "badge-cancelled",
                _ => "badge"
            };
            var statusLabel = o.Status switch {
                OrderStatus.Ordered     => "مطلوب",
                OrderStatus.Shipped     => "مشحون",
                OrderStatus.ArrivingSoon=> "وصول قريب",
                OrderStatus.Received    => "مستلم",
                OrderStatus.Cancelled   => "ملغي",
                _ => ""
            };
            <a href="/orders/@o.Id" class="list-item items-start flex-col gap-1">
                <div class="flex items-center justify-between w-full">
                    <span class="font-display text-base text-ink">@o.Supplier</span>
                    <span class="@badgeClass">@statusLabel</span>
                </div>
                <div class="flex items-center gap-3">
                    <span class="text-xs text-bark-l font-ui">@o.OrderedAt.ToString("yyyy/MM/dd")</span>
                    <span class="text-xs text-bark-l">@o.ItemCount صنف</span>
                    @if (o.PendingShelvingCount > 0)
                    {
                        <span class="text-xs font-semibold text-amber">@o.PendingShelvingCount بانتظار الرف</span>
                    }
                    @if (o.ExpectedArrivalDate.HasValue)
                    {
                        <span class="text-xs text-bark-l">→ @o.ExpectedArrivalDate.Value.ToString("MM/dd")</span>
                    }
                </div>
            </a>
        }
    </div>

    <partial name="_Pagination" model="pager" />
}
