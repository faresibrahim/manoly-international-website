@model ManolyWarehouse.Application.ViewModels.AreaZItemViewModel
@{ ViewData["Title"] = $"تعديل — {Model.ProductName}"; }

<div class="px-4 pt-5 pb-3">
    <a href="/area-z/@Model.Id" class="eyebrow text-bark-l hover:text-bark mb-2 inline-flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        AREA Z · منطقة Z
    </a>
    <p class="eyebrow mb-1">EDIT · تعديل</p>
    <h1 class="font-display text-2xl text-ink">@Model.ProductName</h1>
    <p class="text-sm text-bark-l mt-0.5">@Model.CategoryName</p>
</div>

<div class="mx-4 card p-5 mb-6">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="flex flex-col gap-5">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-2 gap-3">
            <div class="form-group">
                <label class="form-label">عدد الربطات</label>
                <input type="number" name="bundleCount" min="1" class="form-input" value="@Model.BundleCount" required/>
            </div>
            <div class="form-group">
                <label class="form-label">وحدات/ربطة</label>
                <input type="number" name="unitsPerBundle" min="1" class="form-input" value="@Model.UnitsPerBundle" required/>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">ملاحظات (اختيارية)</label>
            <textarea name="notes" class="form-input" rows="2" placeholder="ملاحظات...">@Model.Notes</textarea>
        </div>

        <button type="submit" class="btn-primary w-full">حفظ التعديلات</button>
        <a href="/area-z/@Model.Id" class="btn-secondary w-full text-center">إلغاء</a>
    </form>
</div>
