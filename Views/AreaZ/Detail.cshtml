@model ManolyWarehouse.Application.ViewModels.AreaZItemViewModel
@{ ViewData["Title"] = $"منطقة Z — {Model.ProductName}"; }

<div class="px-4 pt-5 pb-3">
    <a href="/area-z" class="eyebrow text-bark-l hover:text-bark mb-2 inline-flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        AREA Z · منطقة Z
    </a>
    <h1 class="font-display text-2xl text-ink">@Model.ProductName</h1>
    <p class="text-sm text-bark-l mt-0.5">@Model.CategoryName</p>
</div>

<div class="mx-4 card mb-4">
    <div class="list-item justify-between">
        <span class="text-xs text-bark-l font-ui uppercase tracking-wide">الربطات</span>
        <span class="font-display text-2xl text-ink">@Model.BundleCount</span>
    </div>
    <div class="list-item justify-between">
        <span class="text-xs text-bark-l font-ui uppercase tracking-wide">الوحدات</span>
        <span class="font-display text-base text-ink">@Model.TotalQuantity</span>
    </div>
    <div class="list-item justify-between">
        <span class="text-xs text-bark-l font-ui uppercase tracking-wide">الدخول</span>
        <span class="text-sm text-ink">@Model.EnteredAt.ToString("yyyy/MM/dd HH:mm")</span>
    </div>
    <div class="list-item justify-between">
        <span class="text-xs text-bark-l font-ui uppercase tracking-wide">سجّله</span>
        <span class="text-sm text-ink">@Model.EnteredBy</span>
    </div>
    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <div class="px-4 py-3">
            <span class="text-xs text-bark-l font-ui uppercase tracking-wide block mb-1">ملاحظات</span>
            <p class="text-sm text-ink">@Model.Notes</p>
        </div>
    }
</div>

@if (User.IsInRole("Admin"))
{
    <div class="px-4 flex flex-col gap-3 mb-6">
        <a href="/area-z/@Model.Id/edit" class="btn-secondary w-full text-center">تعديل</a>
        <form id="del-areaz-@Model.Id" asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="button"
                    onclick="confirmDelete('حذف من منطقة Z', 'هل أنت متأكد؟', 'del-areaz-@Model.Id')"
                    class="btn-danger w-full">حذف</button>
        </form>
    </div>
}
